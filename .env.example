# ==========================================
# AI Knowledge Inbox - Environment Settings
# ==========================================

# Application Environment (development | production | test)
APP_ENV=development

# FastAPI Host and Port
API_HOST=0.0.0.0
API_PORT=8000

# Allowed Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Database URL
# For Docker / PostgreSQL + pgvector:
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/knowledge_inbox
# For Zero-Configuration Local Development / SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./knowledge_inbox.db

# Google Gemini API Settings (Backend only - never exposed to browser)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=MY_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
EMBEDDING_DIMENSIONS=768

# Document Storage & Ingestion
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Text Chunking and Vector RAG Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35

# Ingestion Worker & Queue Settings
JOB_MAX_RETRIES=3
JOB_POLL_INTERVAL_SECONDS=2
JOB_STALE_TIMEOUT_SECONDS=300

# AI Studio App Hosting URL
APP_URL=MY_APP_URL
